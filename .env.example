# Copy to .env; never commit actual secrets. Use a hex password for the DB URL.
POSTGRES_PASSWORD=replace-with-random-hex
SECRET_KEY=replace-with-at-least-32-random-characters
# Single quotes prevent Compose expansion of the dollar signs in Argon2 hashes.
ADMIN_PASSWORD_HASH='$argon2id$replace-with-generated-hash'
ADMIN_USERNAME=admin
PUBLIC_ORIGIN=http://localhost
SITE_ADDRESS=http://localhost
SITE_URL=http://localhost
SITE_INDEXABLE=false
SECURE_COOKIES=false
LEADS_ENABLED=false
PRIVACY_VERSION=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=
NOTIFICATION_TO=
